# Copy this file to .env and fill in secrets before starting compose.

# Remote 1
RCLONE_REMOTE_NAME=openlist
RCLONE_REMOTE_DIR=/OneDrive2/

# Remote 2
RCLONE_REMOTE_NAME_1=openlist
RCLONE_REMOTE_DIR_1=/jianguoyun1/

# Remote 3
RCLONE_REMOTE_NAME_2=openlist
RCLONE_REMOTE_DIR_2=/hi168/

# Add more remotes directly here when needed.
# Example:
# RCLONE_REMOTE_NAME_3=openlist
# RCLONE_REMOTE_DIR_3=/another/path/

# Optional rclone flags, for example: --transfers 4
RCLONE_GLOBAL_FLAG=

# Required only when rclone.conf is protected by "rclone config encryption".
RCLONE_CONFIG_PASS=

# Cron expression. Example below means minute 5 of every hour.
CRON='5 * * * *'

# Archive
ZIP_ENABLE=TRUE
ZIP_PASSWORD=change-me
ZIP_TYPE=zip

# Retention
BACKUP_FILE_SUFFIX=%Y%m%d_%H%M%S
BACKUP_KEEP_DAYS=30

# Mail notification
MAIL_SMTP_ENABLE=TRUE
MAIL_TO=receiver@example.com
MAIL_WHEN_SUCCESS=TRUE
MAIL_WHEN_FAILURE=TRUE
MAIL_FORCE_THREAD=FALSE
MAIL_SMTP_STARTTLS=-S smtp-use-starttls
MAIL_SMTP_PROTOCOL=smtp
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_AUTH=login
MAIL_SMTP_USER=sender@example.com
MAIL_SMTP_PASSWORD=app-password
MAIL_SMTP_FROM=sender@example.com

# Ping notification
PING_URL=
PING_URL_CURL_OPTIONS=
PING_URL_WHEN_START=
PING_URL_WHEN_START_CURL_OPTIONS=
PING_URL_WHEN_SUCCESS=
PING_URL_WHEN_SUCCESS_CURL_OPTIONS=
PING_URL_WHEN_FAILURE=
PING_URL_WHEN_FAILURE_CURL_OPTIONS=

# Container timezone
TIMEZONE=Asia/Shanghai

# Host paths
VAULTWARDEN_DATA_DIR=/data/vaultwarden/vw-data/
# Host rclone config directory. It should contain rclone/rclone.conf.
RCLONE_CONFIG_DIR=/root/.config
